load("@rules_cc//cc:defs.bzl", "cc_binary")

# gazelle:cc_ambiguous_deps most_matching

cc_binary(
    name = "app",
    srcs = ["app.c"],
    deps = ["//other/variant_a/main_app/lib_config:config"],
)

cc_binary(
    name = "app_uses_b",
    srcs = ["app_uses_b.c"],
    deps = ["//other/variant_b/main_app/lib_config:config"],
)
